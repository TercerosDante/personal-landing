---
/**
 * Build-time SVG icon (monochrome, `currentColor`).
 *
 * Inlines ONLY the referenced icon into the HTML at build time from Iconify
 * devDependencies; the full sets are never shipped, there is no runtime JS and
 * no icon-font CDN. Color it via CSS `color` on a parent.
 *
 * Two sets:
 *   - Tech logos: `@iconify-json/devicon-plain`  →  <Icon name="nestjs" />
 *   - UI glyphs:  `@iconify-json/ph` (Phosphor)  →  <Icon name="ph:envelope-simple" />
 *
 * Browse: https://icon-sets.iconify.design/devicon-plain/ · https://icon-sets.iconify.design/ph/
 */
import { icons as devicon } from '@iconify-json/devicon-plain';
import { icons as phosphor } from '@iconify-json/ph';
import { icons as simpleIcons } from '@iconify-json/simple-icons';
import { getIconData, iconToSVG, iconToHTML, replaceIDs } from '@iconify/utils';

const SETS = { ph: phosphor, si: simpleIcons } as const;

interface Props {
  name: string;
  size?: number;
  title?: string;
  class?: string;
}

const { name, size = 24, title, class: className } = Astro.props;

const [prefix, key] = name.includes(':') ? name.split(':', 2) : ['', name];
const set = prefix ? SETS[prefix as keyof typeof SETS] : devicon;
const data = set ? getIconData(set, key) : null;
if (!data) {
  throw new Error(`[Icon] Unknown icon "${name}".`);
}
const { body, attributes } = iconToSVG(data, { height: size });

const svg = iconToHTML(replaceIDs(body), {
  xmlns: 'http://www.w3.org/2000/svg',
  ...attributes,
  ...(className ? { class: className } : {}),
  ...(title ? { role: 'img', 'aria-label': title } : { 'aria-hidden': 'true' }),
});
---

<Fragment set:html={svg} />
