---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { dict } from '../i18n/content';

const t = dict.colophon;
---

<aside class="colophon">
  <div class="wrap colo-row reveal">
    <div class="colo-main">
      <p class="eyebrow" data-i18n="colophon.label">{t.label}</p>
      <p class="colo-text" data-i18n-html="colophon.text" set:html={t.text} />
    </div>
    <div class="colo-side">
      <ul class="colo-metrics">
        <li>0 runtime deps</li>
        <li>~4 KB JS</li>
        <li>Lighthouse 99+</li>
      </ul>
      <a class="btn ghost colo-src" href={site.repo} target="_blank" rel="noopener">
        <Icon name="ph:github-logo" size={16} />
        <span data-i18n="colophon.source">{t.source}</span>
        <Icon name="ph:arrow-up-right" size={14} />
      </a>
    </div>
  </div>
</aside>
