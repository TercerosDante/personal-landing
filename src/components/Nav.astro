---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { nav } from '../data/nav';
import { dict } from '../i18n/content';
---

<header class="topbar">
  <div class="brand" data-go="#about">
    <b>RONALD&nbsp;TERCEROS</b>
  </div>
  <nav class="nav" id="nav">
    {
      nav.map((item, i) => (
        <a href={item.href} class={i === 0 ? 'on' : undefined}>
          <span data-i18n={`nav.${item.key}`}>{dict.nav[item.key]}</span>
        </a>
      ))
    }
    <a
      href={site.cv.en}
      class="cvbtn"
      data-cv-dl
      download="Ronald-Terceros-CV-EN.pdf"
    >
      <Icon name="ph:download-simple" size={15} />
      <span data-i18n="nav.cv">{dict.nav.cv}</span>
    </a>
  </nav>
  <div class="navtools">
    <button
      id="themeToggle"
      class="tool-btn theme-toggle"
      type="button"
      aria-label="Switch to light theme"
    >
      <Icon name="ph:moon" size={16} class="i-moon" />
      <Icon name="ph:sun" size={16} class="i-sun" />
    </button>
    <button
      id="langToggle"
      class="tool-btn lang-toggle"
      type="button"
      aria-label="Cambiar a español"
    >
      <Icon name="ph:globe-simple" size={15} class="globe" />
      <span class="lang-code">ES</span>
    </button>
    <button
      class="tool-btn menu-btn"
      id="menuBtn"
      type="button"
      aria-label="Open menu"
      aria-controls="nav"
      aria-expanded="false"><i></i><i></i><i></i></button
    >
  </div>
</header>
