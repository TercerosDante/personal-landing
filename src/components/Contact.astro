---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { dict } from '../i18n/content';

const t = dict.contact;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const links = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'ph:envelope-simple', ext: false },
  { label: 'WhatsApp', value: site.phone, href: site.whatsapp, icon: 'ph:whatsapp-logo', ext: true },
  { label: 'LinkedIn', value: site.linkedinHandle, href: site.linkedin, icon: 'ph:linkedin-logo', ext: true },
  { label: 'GitHub', value: '@TercerosDante', href: site.github, icon: 'ph:github-logo', ext: true },
];
---

<section class="sec contact-sec" id="contact">
  <div class="sec-head reveal">
    <h2 data-i18n="contact.title">{t.title}</h2>
    <p class="sub" data-i18n="contact.sub">{t.sub}</p>
  </div>
  <div class="contact-wrap">
    <form class="cform reveal" id="cform" novalidate>
      <div class="field">
        <label for="cf-name" data-i18n="contact.name">{t.name}</label>
        <input
          id="cf-name"
          name="name"
          type="text"
          required
          maxlength="100"
          autocomplete="name"
          aria-describedby="cf-name-err"
          placeholder={t.namePh}
          data-i18n-attr="placeholder:contact.namePh"
        />
        <span class="field-err" id="cf-name-err" role="alert"></span>
      </div>
      <div class="field">
        <label for="cf-email" data-i18n="contact.email">{t.email}</label>
        <input
          id="cf-email"
          name="email"
          type="email"
          required
          maxlength="255"
          autocomplete="email"
          aria-describedby="cf-email-err"
          placeholder={t.emailPh}
          data-i18n-attr="placeholder:contact.emailPh"
        />
        <span class="field-err" id="cf-email-err" role="alert"></span>
      </div>
      <div class="field">
        <label for="cf-msg" data-i18n="contact.message">{t.message}</label>
        <textarea
          id="cf-msg"
          name="message"
          rows="5"
          required
          maxlength="3000"
          aria-describedby="cf-msg-err"
          placeholder={t.msgPh}
          data-i18n-attr="placeholder:contact.msgPh"></textarea>
        <span class="field-err" id="cf-msg-err" role="alert"></span>
      </div>
      {/* Honeypot: hidden from people, tempting to bots. */}
      <div class="hp" aria-hidden="true">
        <label for="cf-website">Website</label>
        <input
          id="cf-website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      {
        turnstileKey && (
          <div id="ts-widget" class="ts-widget" data-sitekey={turnstileKey} />
        )
      }
      <div class="cform-foot">
        <button class="btn solid cform-send" type="submit">
          <span data-i18n="contact.send">{t.send}</span>
          <Icon name="ph:paper-plane-tilt" size={16} />
        </button>
        <span class="cform-note" id="cformNote" data-i18n="contact.note"
          >{t.note}</span
        >
      </div>
      <p class="cform-status" id="cformStatus" role="status" aria-live="polite">
        <span class="cform-status-ico" aria-hidden="true">
          <span class="st-dot"></span>
          <Icon name="ph:check-circle" size={18} class="st-ok" />
          <Icon name="ph:warning-circle" size={18} class="st-err" />
        </span>
        <span class="cform-status-text"></span>
      </p>
    </form>
    <ul class="contact-links reveal" style="--i:1">
      {
        links.map((l) => (
          <li>
            <a
              class="clink"
              href={l.href}
              {...(l.ext ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <Icon name={l.icon} size={22} class="clink-ico" />
              <span class="clink-txt">
                <span class="cl">{l.label}</span>
                <span class="cv">{l.value}</span>
              </span>
              <Icon name="ph:arrow-up-right" size={16} class="clink-arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
