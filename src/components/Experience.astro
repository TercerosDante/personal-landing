---
import { experience } from '../data/experience';
import { dict } from '../i18n/content';

const t = dict.exp;
---

<section class="sec" id="experience">
  <div class="sec-head reveal">
    <h2 data-i18n="exp.title">{t.title}</h2>
    <p class="sub" data-i18n="exp.sub">{t.sub}</p>
  </div>
  <div class="xp-list">
    {
      experience.map((co, ci) => (
        <div class="xp">
          <header class="xp-co reveal">
            <h3>{co.name}</h3>
            <p class="when" data-i18n={`exp.companies.${ci}.when`}>
              {t.companies[ci].when}
            </p>
            <p class="meta" data-i18n={`exp.companies.${ci}.meta`}>
              {t.companies[ci].meta}
            </p>
          </header>
          <div class="xp-roles">
            {co.roles.map((role, ri) => (
              <article class="xp-role reveal">
                <div class="xp-role-head">
                  <h4>{role.name}</h4>
                  <span
                    class="tag-cli"
                    data-i18n={`exp.companies.${ci}.roles.${ri}.client`}
                  >
                    {t.companies[ci].roles[ri].client}
                  </span>
                </div>
                <ul class="xp-bullets">
                  {t.companies[ci].roles[ri].bullets.map((b, bi) => (
                    <li
                      data-i18n={`exp.companies.${ci}.roles.${ri}.bullets.${bi}`}
                    >
                      {b}
                    </li>
                  ))}
                </ul>
                <ul class="chips">
                  {role.tags.map((tag) => (
                    <li class={tag.hot ? 'hot' : undefined}>{tag.label}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
