---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { projectGroups } from '../data/projects';
import { dict } from '../i18n/content';

const t = dict.proj;

/**
 * Layout per group, so the section never repeats one composition:
 *   independent → first item is a full-width feature, the rest are splits
 *   team        → a two-column grid of stacked cards
 */
const variantFor = (kind: string, i: number) =>
  kind === 'team' ? 'stacked' : i === 0 ? 'feature' : 'split';
---

<section class="sec" id="projects">
  <div class="sec-head reveal">
    <h2 data-i18n="proj.title">{t.title}</h2>
    <p class="sub" data-i18n="proj.sub">{t.sub}</p>
  </div>
  <div class="proj-groups">
    {
      projectGroups.map((group, gi) => {
        const g = t.groups[gi];
        return (
          <div class="proj-group-section">
            <div class="proj-group reveal">
              <Icon
                name={group.kind === 'team' ? 'ph:users-three' : 'ph:user'}
                size={18}
                class="pg-ico"
              />
              <h3 class="pg-label" data-i18n={`proj.groups.${gi}.label`}>
                {g.label}
              </h3>
              <span class="pg-rule" />
              <span class="pg-meta" data-i18n={`proj.groups.${gi}.note`}>
                {g.note}
              </span>
            </div>
            <div class={`proj-grid is-${group.kind}`}>
              {group.items.map((p, i) => {
                const item = g.items[i];
                const live = item.live;
                const base = `proj.groups.${gi}.items.${i}`;
                const variant = variantFor(group.kind, i);
                const sizes =
                  variant === 'feature'
                    ? '(max-width:1180px) 92vw, 1100px'
                    : variant === 'split'
                      ? '(max-width:900px) 92vw, 540px'
                      : '(max-width:900px) 92vw, 520px';
                return (
                  <article class={`proj is-${variant} reveal`}>
                    <div class="proj-thumb">
                      <Picture
                        src={p.image}
                        alt={item.alt ?? ''}
                        data-i18n-attr={`alt:${base}.alt`}
                        formats={['avif', 'webp']}
                        fallbackFormat="webp"
                        widths={[480, 560, 760, 1100, 1600]}
                        sizes={sizes}
                      />
                      <span class="zoom-hint">
                        <span class="zh">
                          <Icon name="ph:magnifying-glass-plus" size={20} />
                        </span>
                      </span>
                    </div>
                    <div class="proj-body">
                      <div class="proj-meta">
                        <p class="p-year" data-i18n={`${base}.year`}>
                          {item.year}
                        </p>
                        <h4 class="p-title" data-i18n={`${base}.title`}>
                          {item.title}
                        </h4>
                        {(live || p.model) && (
                          <div class="p-badges">
                            {live && (
                              <span class="live">
                                <i />
                                <span data-i18n={`${base}.live`}>{live}</span>
                              </span>
                            )}
                            {p.model?.map((m) => (
                              <span class="p-model">{m}</span>
                            ))}
                          </div>
                        )}
                        {(p.link || p.repo) && (
                          <div class="p-links">
                            {p.link && (
                              <a
                                class="btn view"
                                href={p.link}
                                target="_blank"
                                rel="noopener"
                              >
                                <span data-i18n="proj.view">{t.view}</span>
                                <Icon name="ph:arrow-up-right" size={15} />
                              </a>
                            )}
                            {p.repo === 'walkthrough' && (
                              <a class="repo" href="#contact">
                                <Icon name="ph:github-logo" size={15} />
                                <span data-i18n="proj.privateRepo">
                                  {t.privateRepo}
                                </span>
                              </a>
                            )}
                            {p.repo === 'private' && (
                              <span class="repo is-locked">
                                <Icon name="ph:lock-simple" size={15} />
                                <span data-i18n="proj.privateRepo">
                                  {t.privateRepo}
                                </span>
                              </span>
                            )}
                          </div>
                        )}
                      </div>
                      <div class="proj-text">
                        <p class="p-summary" data-i18n={`${base}.summary`}>
                          {item.summary}
                        </p>
                        <details class="p-tech">
                          <summary data-i18n="proj.techDetails">
                            {t.techDetails}
                          </summary>
                          <div class="p-product">
                            {item.product.map((par, pi) => (
                              <p data-i18n={`${base}.product.${pi}`}>{par}</p>
                            ))}
                          </div>
                          <p class="p-tech-body" data-i18n={`${base}.tech`}>
                            {item.tech}
                          </p>
                          <ul class="chips">
                            {p.tags.map((tag) => (
                              <li class={tag.hot ? 'hot' : undefined}>
                                {tag.label}
                              </li>
                            ))}
                          </ul>
                        </details>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
