---
import { education } from '../data/education';
import { dict } from '../i18n/content';

const t = dict.edu;
---

<section class="sec" id="education">
  <div class="sec-head reveal">
    <h2 data-i18n="edu.title">{t.title}</h2>
  </div>
  <div class="edu-grid">
    <ol class="edu-list">
      {
        education.map((e, i) => (
          <li class="edu reveal" style={`--i:${i}`}>
            <span class="yr">{e.year}</span>
            <div class="ed-b">
              <h3 data-i18n={`edu.items.${i}.title`}>{t.items[i].title}</h3>
              <p class="inst" data-i18n={`edu.items.${i}.inst`}>
                {t.items[i].inst}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="langs reveal" style="--i:1">
      <h3 class="langs-h" data-i18n="edu.languages">{t.languages}</h3>
      <dl>
        {
          t.langs.map((l, i) => (
            <div class="lang">
              <dt data-i18n={`edu.langs.${i}.name`}>{l.name}</dt>
              <dd data-i18n={`edu.langs.${i}.level`}>{l.level}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
