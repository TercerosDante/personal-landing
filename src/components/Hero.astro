---
import { Picture } from 'astro:assets';
import profile from '../assets/profile.png';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { coreStack } from '../data/coreStack';
import { dict } from '../i18n/content';
---

<section class="sec intro" id="about">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="hero-role load-fx">
        <span data-i18n="hero.role">{dict.hero.role}</span>
        <span class="tagline" aria-hidden="true"
          ><span class="tw" id="tw"></span></span
        >
      </p>
      <h1 class="hero-name">
        <span class="name-reveal">
          {site.firstName}
          <span class="l2">{site.lastName}</span>
        </span>
      </h1>
      <p class="hero-sub load-fx" style="--i:2" data-i18n="hero.sub">
        {dict.hero.sub}
      </p>
      <div class="hero-cta load-fx" style="--i:3">
        <div class="cv-menu" data-cv-menu>
          <a
            class="btn solid cv-main"
            data-cv-dl
            href={site.cv.en}
            download="Ronald-Terceros-CV-EN.pdf"
          >
            <Icon name="ph:download-simple" size={16} />
            <span data-i18n="nav.cv">{dict.nav.cv}</span>
          </a>
          <button
            class="btn solid cv-caret"
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="cvPop"
            aria-label="Choose CV language"
          >
            <Icon name="ph:caret-down" size={14} />
          </button>
          <div class="cv-pop" id="cvPop" role="menu" hidden>
            <a
              class="cv-opt"
              role="menuitem"
              data-cv-lang="en"
              href={site.cv.en}
              download="Ronald-Terceros-CV-EN.pdf"
            >
              <span class="cv-code">EN</span>
              <span class="cv-name">English</span>
              <span class="cv-ext">PDF</span>
            </a>
            <a
              class="cv-opt"
              role="menuitem"
              data-cv-lang="es"
              href={site.cv.es}
              download="Ronald-Terceros-CV-ES.pdf"
            >
              <span class="cv-code">ES</span>
              <span class="cv-name">Español</span>
              <span class="cv-ext">PDF</span>
            </a>
          </div>
        </div>
        <a class="btn ghost" href="#contact">
          <span data-i18n="nav.contact">{dict.nav.contact}</span>
          <Icon name="ph:arrow-right" size={16} />
        </a>
      </div>
    </div>
    <figure class="portrait load-fx" style="--i:1">
      <Picture
        src={profile}
        alt={`${site.name}, ${site.role}`}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[320, 480, 720]}
        sizes="(max-width:760px) 50vw, 300px"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>

  <div class="intro-body">
    <p
      class="about-lead reveal"
      data-i18n-html="hero.lead"
      set:html={dict.hero.lead}
    />
    <div class="core reveal" style="--i:1">
      <p class="core-l" data-i18n="hero.coreStack">{dict.hero.coreStack}</p>
      <ul class="core-list">
        {
          coreStack.map((c) => (
            <li class="cchip">
              {c.icon ? (
                <Icon name={c.icon} size={20} />
              ) : (
                <b class="cm">{c.mono}</b>
              )}
              <span>{c.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
